# Anthropic key for the Ask panel. LE_ANTHROPIC_API_KEY wins if both are set.
LE_ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY=

# Resend key for the contact form. Without it the form returns 503 and
# inquiries are lost, so this one is not optional at launch.
LE_RESEND_API_KEY=

# Optional. Where inquiries are emailed, and who they come from. The defaults
# are rob@leffect.com and inquiries@send.leffect.com, and the From has to be on
# a domain Resend has verified or it refuses to send.
#
# To run before the DNS is verified, set both to Resend's test sender and the
# address the Resend account was opened with. It only delivers to that one
# address, and the mail arrives from resend.dev rather than from the practice,
# but the form works:
#   LE_INQUIRY_FROM=Lake Effect Site <onboarding@resend.dev>
#   LE_INQUIRY_TO=whoever@example.com
LE_INQUIRY_TO=
LE_INQUIRY_FROM=

# Hosts allowed to call the endpoints, comma separated. Same-origin,
# localhost and *.vercel.app are always allowed.
ALLOWED_ORIGINS=leffect.com,www.leffect.com

# Spend ceiling for /api/ask, dollars per hour per serverless instance.
# A backstop only: instances are many and short-lived, so the limit that
# actually holds is the monthly cap set in the Anthropic Console.
# 0.5 is about eleven questions an hour, sized against a $5 month.
LE_ASK_HOURLY_USD=0.5

# Optional. A Google Apps Script web app URL. Every inquiry is posted here as
# JSON as well as emailed, so one lost message is not a lost inquiry. If it is
# unset the form still works and only sends the email.
LE_SHEET_WEBHOOK_URL=
